# SMTP credentials used to send the report email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-account@gmail.com

# Agent defaults (can be overridden via CLI flags too)
SCAM_SOURCE_URL=https://www.scamwatcher.com/scam/view/724988
SCAM_TOP_N=10
SCAM_REPORT_RECIPIENT=dmuftic@ziraatbank.ba
